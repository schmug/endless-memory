// Endless Memory v1 — synthesized sounds only. Paste into Strudel and play.
// Score anchor: 2026-09-10T23:50:48.831Z. UTC day phases. Replay starts here, not at the current clock.
setcps(76/60/4)
const BPM=76, BARS=32, BAR_MS=3157.8947368421054, EPOCH=1767225600000;
const journal={'version':1,'seed':'window-seat-v1','events':[]};
function hash(value) {
  let h = 2166136261;
  for (const c of String(value)) h = Math.imul(h ^ c.charCodeAt(0), 16777619);
  return h >>> 0;
}
function pick(key, values) { return values[hash(key) % values.length]; }
function scene(index, journal) {
  const at = EPOCH + index * BARS * BAR_MS;
  // Events only take effect at scene boundaries. Stable tie ordering is part of v1.
  const events = journal.events.filter(e => Date.parse(e.at) <= at)
    .sort((a,b) => Date.parse(a.at)-Date.parse(b.at) || a.id.localeCompare(b.id));
  const weatherEvent = events.filter(e => e.type === 'weather').at(-1);
  const weather = weatherEvent?.value ?? 'clear';
  const weatherKnown = !!weatherEvent;
  const day = new Date(at).toISOString().slice(0,10);
  const hour = new Date(at).getUTCHours();
  const phase = hour < 6 ? 'night' : hour < 12 ? 'morning' : hour < 19 ? 'afternoon' : 'evening';
  const seed = journal.seed + ':' + day + ':' + (weatherEvent?.id ?? 'quiet');
  const born = 'm' + (hash(seed) % 100000000);
  // Recent remembered themes gradually lose influence; explicit favorites recur longer.
  const remembered = events.filter(e => e.type === 'remember' && at-Date.parse(e.at) < 30*86400000);
  const candidates = [...new Set(remembered.map(e => e.motif))];
  const recall = candidates.length > 0 && hash(index + ':recall') % 4 === 0;
  const motif = recall ? pick(index + ':memory', candidates) : born;
  const degrees = Array.from({length: 8}, (_,i) => pick(motif + ':pitch:' + i, [0,2,4,6,7,9,11]));
  const progressions = [[0,5,3,4],[0,3,5,4],[0,5,1,4]];
  const progression = pick(day + ':harmony', progressions);
  const scale = [0,2,3,5,7,8,10]; // A minor, shared by every remembered theme.
  const pitch = d => 57 + scale[((d%7)+7)%7] + 12*Math.floor(d/7);
  const chords = [], bass = [], melody = [], hats = [], kicks = [], snares = [];
  for (let bar=0; bar<BARS; bar++) {
    const root = progression[Math.floor(bar/2)%4];
    const breakBar = bar >= 28;
    chords.push('[' + [0,2,4,6].map(d=>pitch(root+d)).join(',') + ']');
    bass.push('[' + (pitch(root)-24) + ' ~ ' + (pitch(root)-12) + ' ~]');
    // A recognizable rhythmic signature repeats; each fourth phrase leaves room.
    const active = bar%8 < 6 && !(phase==='night' && bar%2);
    melody.push(active ? '[' + degrees.map((d,i) => i===1 || i===4 || (bar%4===3 && i>5) ? '~' : pitch(root+d%7)+12).join(' ') + ']' : '~');
    hats.push(breakBar ? '~' : '[1 1 1 1 1 1 1 1]');
    kicks.push(breakBar ? '[1 ~ ~ ~]' : pick(index + ':kick:' + (bar%4), ['[1 ~ ~ ~]','[1 ~ ~ 1]']));
    snares.push(breakBar ? '~' : '[~ 1 ~ 1]');
  }
  const wrap = a => '<' + a.join(' ') + '>';
  return {index, at:new Date(at).toISOString(), motif, recalled:recall, weather, weatherKnown, phase,
    cutoff: weather==='rain' ? 1100 : weather==='snow' ? 850 : 1800,
    chords:wrap(chords), bass:wrap(bass), melody:wrap(melody), hats:wrap(hats), kicks:wrap(kicks), snares:wrap(snares)};
}
const cache=new Map();
const startBar=6921905;
const music=new Pattern(state=>{
 const begin=Number(state.span.begin), end=Number(state.span.end);
 const haps=[];
 for(let i=Math.floor((begin+startBar)/BARS);i<Math.ceil((end+startBar)/BARS);i++){
  if(!cache.has(i)){const part=scene(i,journal);cache.set(i,stack(
  note(mini(part.chords)).s('triangle').attack(.06).decay(.7).sustain(.25).release(.6).lpf(part.cutoff).gain(.14),
  note(mini(part.bass)).s('sine').attack(.012).decay(.25).sustain(.15).release(.15).gain(.26),
  note(mini(part.melody)).s('triangle').attack(.01).decay(.16).sustain(0).release(.18).lpf(2300).gain(.09),
  s('sine').struct(mini(part.kicks)).freq(52).attack(.002).decay(.13).sustain(0).release(.04).gain(.32),
  s('white').struct(mini(part.snares)).attack(.001).decay(.08).sustain(0).release(.025).hpf(1100).lpf(4200).gain(.07),
  s('white').struct(mini(part.hats)).attack(.001).decay(.018).sustain(0).release(.008).hpf(6500).gain(.025)
));}
  const a=Math.max(begin,i*BARS-startBar), b=Math.min(end,(i+1)*BARS-startBar);
  haps.push(...cache.get(i).early(startBar-i*BARS).queryArc(a,b));
 }
 if(cache.size>8){for(const k of cache.keys())if(k<Math.floor((begin+startBar)/BARS)-1)cache.delete(k);}
 return haps;
});
music
