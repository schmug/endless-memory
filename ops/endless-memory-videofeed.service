# The frame writer. Install to /etc/systemd/system/.
#
# Deliberately INDEPENDENT of endless-memory-stream.service: no BindsTo, no Requires, no
# PartOf. ops/stream.sh holds the fifo open read-write on fd 3, so this unit can crash,
# restart, or be replaced by one that reads piece D's frames without ffmpeg ever seeing
# EOF. Any dependency here would put the frame writer back in the broadcast path.

[Unit]
Description=Endless Memory — write video frames into the broadcast fifo
# NO start limit. A start limit makes systemd give up after a burst, and for a 24/7
# station permanent dead air is strictly worse than a restart loop. Crash-looping is
# caught by alerting, not by refusing to restart.
#
# This key belongs to [Unit], NOT [Service]: systemd moved it in v229, and systemd 252
# reports it in [Service] as "Unknown key ... ignoring" and silently applies the
# default limit — five restarts in ten seconds, then it gives up. It was in the wrong
# section here until `systemd-analyze verify` was actually run on 2026-09-14.
StartLimitIntervalSec=0

[Service]
Type=simple
User=endless
Group=endless
WorkingDirectory=/opt/endless-memory

ExecStart=/bin/bash /opt/endless-memory/ops/videofeed.sh

# Piece D (#38) sets FRAME_SOURCE when it exists. Unset, videofeed emits the
# placeholder — which is the launch state and must stay a working one.
Environment=VIDEO_FIFO=/run/endless-memory/video.fifo

Restart=always
RestartSec=2

RuntimeDirectory=endless-memory
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0750

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes

[Install]
WantedBy=multi-user.target
