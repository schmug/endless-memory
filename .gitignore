node_modules/

# Derived from `node station.mjs export`. Each embeds the anchor timestamp it
# was generated with, so committing them means churn on every run. The README's
# "Try it" section regenerates them.
endless-memory.strudel
score-45min.json
listen.url

# Secrets never reach this repository. This is a backstop, not the reason:
# CF_STREAM_KEY lives only in /etc/endless-memory/stream.env on the host.
*.env
.env*
.dev.vars
ops/secrets/
